# Copy to .env (git-ignored) or export these before starting the backend. All optional.

# Narration, option 1: Groq (hosted). Free keys at https://console.groq.com/keys
# GROQ_API_KEY=gsk_...

# Narration, option 2: any OpenAI-compatible server, e.g. a local Ollama.
# Takes precedence over GROQ_API_KEY when set.
# SHOCKWAVE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# SHOCKWAVE_LLM_MODEL=llama3.2
# SHOCKWAVE_LLM_API_KEY=

# Set to 0 to accept vocabulary concepts only (skips loading the model at startup).
# SHOCKWAVE_FREE_TEXT=1
